# Ignore all .env files (contain secrets)
# Note: .env now lives in data/.env (for docker-compose)
**/.env
# Also ignore backup files created by reset command
**/.env.backup
# Keep .env.example templates (safe to commit)
!**/.env.example

# Runtime data (mounted volumes)
data/*
workspace/
# Optional: ignore workspace directory if you don't want it in repo
workspace/
# Re-allow per-service .env.example templates (safe to commit).
# Order matters: a negation cannot re-include files under an excluded dir,
# so each service dir is un-ignored, then re-ignored except .env.example.
!data/hermes/
data/hermes/*
!data/hermes/.env.example
!data/open-webui/
data/open-webui/*
!data/open-webui/.env.example
!data/camofox-browser/
data/camofox-browser/*
!data/camofox-browser/.env.example
# Python/bytecode artefacts
__pycache__/
*.pyc
# OS artefacts
.DS_Store
Thumbs.db
# IDE/editor artefacts
.vscode/
.idea/
# Docker artefacts
docker-compose.override.yml
# Logs
logs/
# Temporary files
*~
*.swp

# Backup files from reset/upgrade commands
*.bak*
*.bak_*
.backups/
backup/

