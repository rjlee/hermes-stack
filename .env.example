# Root .env - secrets are defined here and used by all services via Docker Compose

WORKSPACE_DIR=./workspace

# =============================================================================
# REQUIRED - Secrets
# =============================================================================
# API_SERVER_KEY will be generated by ./hermes-stack setup
#API_SERVER_KEY=your_api_key_here

# =============================================================================
# OPTIONAL - Build settings
# =============================================================================
# Override image (e.g., nousresearch/hermes-agent:v2026.4.8)
#HERMES_IMAGE=nousresearch/hermes-agent:latest

# =============================================================================
# OPTIONAL - Container user mapping (for v0.9+)
# =============================================================================
# Remap container hermes user to match host UID/GID (default: 1000)
#HERMES_UID=1000
#HERMES_GID=1000
# =============================================================================
# Sandbox volume mounts (execute_code docker backend)
# =============================================================================
# JSON list parsed by terminal_tool as terminal.docker_volumes override.
# NOTE: do NOT mount /var/run/docker.sock into sandboxes (root-equivalent host takeover).
# Source of truth shared by the gateway (compose env_file) and 'hermes-stack cli'
# (--env-file). Kept in env rather than config.yaml so a config reseed from
# cli-config.yaml.example never wipes the sandbox mounts.
#
# @REPO_DIR@ is substituted by './hermes-stack setup' with the repo dir, so the
# absolute host paths (resolved by the host docker daemon) stay portable.
TERMINAL_DOCKER_VOLUMES='["/srv/pass:/srv/pass:ro", "/srv/pass-gnupg:/srv/pass-gnupg:rw", "/opt/data:/opt/data:rw", "@REPO_DIR@/data/output:/output:rw", "@REPO_DIR@/data/hermes/.local:/opt/data/.local:ro", "@REPO_DIR@/data/open-webui/uploads:/opt/uploads:ro", "/workspace:/workspace", "@REPO_DIR@/data/hermes-ssh:/root/.ssh:ro", "/srv/kb:/kb:ro"]'

# Sandbox docker run extra args (JSON list). Mirrors config.yaml
# terminal.docker_extra_args so a config freshly seeded from cli-config.yaml.example
# (which lacks it) still injects /opt/data/.env into sandboxes. Used only when
# config.yaml does not set terminal.docker_extra_args.
TERMINAL_DOCKER_EXTRA_ARGS='["--env-file", "/opt/data/.env", "-e", "PATH=/opt/data/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin", "-e", "PYTHONPATH=/opt/data/.local/lib/python3.11/site-packages", "-v", "@REPO_DIR@/data/hermes/.profile:/root/.profile:ro"]'
# @REPO_DIR@ substitution applied by setup; on the live stack TERMINAL_DOCKER_EXTRA_ARGS
# overrides the config.yaml terminal.docker_extra_args (env takes precedence).

# =============================================================================
# File-write safety (write_file / patch tools)
# =============================================================================
# Prefixes the agent may write under, colon-separated. Defaults to /opt/data
# (baked into the image). /kb is mounted rw into the gateway; /tmp is scratch.
HERMES_WRITE_SAFE_ROOT=/opt/data:/tmp:/kb
